@page "/documents"
@rendermode InteractiveAuto
@inject HttpClient Http

<PageTitle>Document Library</PageTitle>

<h1>Document Library</h1>
<p style="color:#666;">
    All uploaded PDFs. <a href="/upload"><i class="bi bi-upload"></i> Upload new PDF</a>
</p>

@if (_loading)
{
    <p><i class="bi bi-hourglass-split"></i> Loading...</p>
}
else if (_documents.Count == 0)
{
    <div style="text-align:center;padding:3rem;color:#888;">
        <i class="bi bi-folder-x" style="font-size:3rem;display:block;margin-bottom:1rem;"></i>
        No documents yet. <a href="/upload">Upload a PDF</a> to get started.
    </div>
}
else
{
    @foreach (var doc in _documents)
    {
        <div style="border:1px solid #ddd;border-radius:8px;padding:1rem;margin-bottom:1rem;display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;">
            <div>
                <i class="bi bi-file-earmark-pdf-fill" style="color:#dc3545;margin-right:0.4rem;font-size:1.2rem;"></i>
                <strong>@doc.OriginalName</strong>
                <span style="margin-left:0.75rem;font-size:0.85rem;color:#666;">
                    @doc.PageCount page(s) &middot; @doc.CreatedAt.ToString("MMM d, yyyy")
                </span>
                <span style="margin-left:0.5rem;padding:0.1rem 0.5rem;border-radius:4px;font-size:0.8rem;
                             background:@(doc.Status == "ready" ? "#d1e7dd" : doc.Status == "failed" ? "#f8d7da" : "#fff3cd");
                             color:@(doc.Status == "ready" ? "#0f5132" : doc.Status == "failed" ? "#842029" : "#664d03");">
                    @doc.Status
                </span>
            </div>
            <div style="display:flex;gap:0.5rem;flex-shrink:0;">
                @if (doc.Status == "ready")
                {
                    <a href="/exams/new?documentId=@doc.Id"
                       style="padding:0.4rem 0.8rem;background:#0d6efd;color:white;border-radius:4px;text-decoration:none;display:inline-flex;align-items:center;gap:0.3rem;font-size:0.9rem;">
                        <i class="bi bi-stars"></i> Generate Exam
                    </a>
                }
                <button @onclick="() => ConfirmDelete(doc)"
                        style="padding:0.4rem 0.8rem;background:#dc3545;color:white;border:none;border-radius:4px;cursor:pointer;display:inline-flex;align-items:center;gap:0.3rem;font-size:0.9rem;">
                    <i class="bi bi-trash-fill"></i> Delete
                </button>
            </div>
        </div>
    }
}

@if (_deleteTarget is not null)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;z-index:1000;">
        <div style="background:white;border-radius:12px;padding:2rem;max-width:420px;width:90%;box-shadow:0 8px 32px rgba(0,0,0,0.2);">
            <h3 style="margin:0 0 0.5rem;">
                <i class="bi bi-exclamation-triangle-fill" style="color:#dc3545;"></i> Delete Document?
            </h3>
            <p style="color:#555;margin:0.5rem 0 1.5rem;">
                This will permanently delete <strong>@_deleteTarget.OriginalName</strong>
                and all its chunks. Any exams generated from it will still exist but cannot regenerate questions.
            </p>
            <div style="display:flex;gap:0.75rem;justify-content:flex-end;">
                <button @onclick="CancelDelete"
                        style="padding:0.5rem 1rem;background:#6c757d;color:white;border:none;border-radius:4px;cursor:pointer;">
                    Cancel
                </button>
                <button @onclick="ExecuteDelete" disabled="@_deleting"
                        style="padding:0.5rem 1rem;background:#dc3545;color:white;border:none;border-radius:4px;cursor:pointer;">
                    <i class="bi bi-trash-fill"></i> @(_deleting ? "Deleting..." : "Yes, Delete")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<DocumentDto> _documents = new();
    private bool _loading = true;
    private DocumentDto? _deleteTarget;
    private bool _deleting;

    protected override async Task OnInitializedAsync() => await LoadDocuments();

    private async Task LoadDocuments()
    {
        _loading = true;
        try
        {
            var result = await Http.GetFromJsonAsync<List<DocumentDto>>("/api/documents");
            _documents = result ?? [];
        }
        catch { }
        finally { _loading = false; }
    }

    private void ConfirmDelete(DocumentDto doc) => _deleteTarget = doc;
    private void CancelDelete() => _deleteTarget = null;

    private async Task ExecuteDelete()
    {
        if (_deleteTarget is null) return;
        _deleting = true;
        try
        {
            var response = await Http.DeleteAsync($"/api/documents/{_deleteTarget.Id}");
            if (response.IsSuccessStatusCode)
            {
                _documents.Remove(_deleteTarget);
                _deleteTarget = null;
            }
        }
        catch { }
        finally { _deleting = false; }
    }

    private record DocumentDto(Guid Id, string OriginalName, string Status, int? PageCount, DateTime CreatedAt);
}
