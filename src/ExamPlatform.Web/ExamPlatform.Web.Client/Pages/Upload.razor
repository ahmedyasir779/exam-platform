@page "/upload"
@rendermode InteractiveAuto
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Upload PDF</PageTitle>

<h1>Upload PDF</h1>
<p>Upload an educational PDF to generate exams from it.</p>

<div style="border:2px dashed #ccc;padding:2rem;border-radius:8px;max-width:500px;">
    <InputFile OnChange="OnFileSelected" accept=".pdf" />

    @if (_uploading)
    {
        <p style="margin-top:1rem;color:#666;">
            <i class="bi bi-hourglass-split"></i> Uploading...
        </p>
    }

    @if (_documentId.HasValue)
    {
        <div style="margin-top:1rem;">
            @if (_status == "processing")
            {
                <p><i class="bi bi-gear-fill" style="color:#fd7e14;"></i> Processing PDF... this may take up to 30 seconds.</p>
            }
            else if (_status == "ready")
            {
                <p style="color:green;">
                    <i class="bi bi-check-circle-fill"></i> Ready!
                </p>
                <a href="/exams/new?documentId=@_documentId"
                   style="display:inline-flex;align-items:center;gap:0.4rem;margin-top:0.5rem;padding:0.5rem 1rem;background:#0d6efd;color:white;border-radius:4px;text-decoration:none;">
                    <i class="bi bi-stars"></i> Generate Exam
                </a>
            }
            else if (_status == "failed")
            {
                <p style="color:red;">
                    <i class="bi bi-x-circle-fill"></i> Processing failed. Please try a different PDF.
                </p>
            }
            else
            {
                <p><i class="bi bi-clock"></i> Status: <strong>@_status</strong></p>
            }
        </div>
    }

    @if (_error is not null)
    {
        <p style="color:red;margin-top:1rem;">
            <i class="bi bi-exclamation-triangle-fill"></i> @_error
        </p>
    }
</div>

@code {
    private bool _uploading;
    private Guid? _documentId;
    private string? _status;
    private string? _error;
    private System.Timers.Timer? _pollTimer;

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _uploading = true;
        _error = null;
        _documentId = null;
        _status = null;

        try
        {
            using var content = new MultipartFormDataContent();
            var stream = e.File.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
            content.Add(new StreamContent(stream), "file", e.File.Name);

            var response = await Http.PostAsync("/api/documents/upload", content);
            if (!response.IsSuccessStatusCode)
            {
                _error = $"Upload failed: {response.StatusCode}";
                _uploading = false;
                return;
            }

            var doc = await response.Content.ReadFromJsonAsync<DocumentStatusDto>();
            _documentId = doc?.Id;
            _status = doc?.Status;
            _uploading = false;

            _pollTimer = new System.Timers.Timer(2500);
            _pollTimer.Elapsed += async (_, _) => await PollStatus();
            _pollTimer.AutoReset = true;
            _pollTimer.Start();
        }
        catch (Exception ex)
        {
            _error = $"Error: {ex.Message}";
            _uploading = false;
        }
    }

    private async Task PollStatus()
    {
        if (!_documentId.HasValue) return;
        try
        {
            var dto = await Http.GetFromJsonAsync<DocumentStatusDto>($"/api/documents/{_documentId}/status");
            _status = dto?.Status;

            if (_status is "ready" or "failed")
            {
                _pollTimer?.Stop();
                _pollTimer?.Dispose();
                _pollTimer = null;
            }
        }
        catch { }
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _pollTimer?.Stop();
        _pollTimer?.Dispose();
    }

    private record DocumentStatusDto(Guid Id, string OriginalName, string Status, int? PageCount, DateTime CreatedAt);
}
